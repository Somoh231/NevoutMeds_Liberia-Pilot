# NevOut Meds backup configuration — TEMPLATE. Copy to ops/backup/backup.env (gitignored),
# fill in, and `chmod 600` it. Never commit real values. Prefer *_FILE variables that point
# to chmod-600 files over putting secrets in this file.

# ── What and where ───────────────────────────────────────────────────────────
NEVOUT_BACKUP_PROJECT=prod                      # appears in artifact names: nevoutmeds-db-prod-<UTC stamp>
NEVOUT_BACKUP_DIR=/var/backups/nevoutmeds       # local copy (always kept); created chmod 700
NEVOUT_BACKUP_RETENTION_DAYS=30                 # delete artifacts older than this …
NEVOUT_BACKUP_KEEP_MIN=7                        # … but always keep at least this many of each kind

# ── Encryption (REQUIRED) ────────────────────────────────────────────────────
# ≥ 20 characters. Store a copy OFFLINE (password manager / sealed envelope):
# without it, no backup can ever be restored.
NEVOUT_BACKUP_PASSPHRASE_FILE=/etc/nevoutmeds/backup-passphrase

# ── Database dump engine ─────────────────────────────────────────────────────
# pg: needs the database connection string (Supabase dashboard → Connect → Session pooler).
#     Uses native pg_dump >= 17, else Docker with NEVOUT_PG_IMAGE.
# supabase-cli: uses `supabase db dump --linked` (the CLI login) — no DB password on disk.
NEVOUT_BACKUP_ENGINE=auto                       # auto | pg | supabase-cli
NEVOUT_BACKUP_DB_URL_FILE=/etc/nevoutmeds/db-url
# NEVOUT_PG_IMAGE=public.ecr.aws/supabase/postgres:17.6.1.166

# ── Heartbeat + Storage backup (service role — backup host only) ─────────────
NEVOUT_SUPABASE_URL=https://<project-ref>.supabase.co
NEVOUT_SERVICE_ROLE_KEY_FILE=/etc/nevoutmeds/service-role-key

# ── Off-site destination ─────────────────────────────────────────────────────
# local            keep only in NEVOUT_BACKUP_DIR (NOT an off-site backup)
# dir:/mnt/backup  copy to a mounted disk / NAS path
# s3               any S3-compatible store (AWS S3, Cloudflare R2, Backblaze B2, MinIO) — below
# rclone:<remote>:<path>   anything rclone supports (rclone must be installed and configured)
NEVOUT_BACKUP_DEST=local
# NEVOUT_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # or https://s3.<region>.amazonaws.com, https://s3.<region>.backblazeb2.com
# NEVOUT_BACKUP_S3_BUCKET=nevoutmeds-backups
# NEVOUT_BACKUP_S3_REGION=auto                   # R2: auto · AWS: e.g. eu-west-1 · B2: e.g. us-west-004
# NEVOUT_BACKUP_S3_ACCESS_KEY_ID=<key id with write+list+delete on the bucket only>
# NEVOUT_BACKUP_S3_SECRET_ACCESS_KEY_FILE=/etc/nevoutmeds/s3-secret
# NEVOUT_BACKUP_S3_PREFIX=nevoutmeds/prod/

# ── Restore targets (only when restoring) ────────────────────────────────────
# NEVOUT_RESTORE_DB_URL=postgresql://postgres:<password>@<new-project-host>:5432/postgres
# NEVOUT_RESTORE_SUPABASE_URL=https://<new-project-ref>.supabase.co
# NEVOUT_RESTORE_SERVICE_ROLE_KEY_FILE=/etc/nevoutmeds/new-project-service-role-key

# ── Monitoring (ops/monitor/health-check.mjs) ────────────────────────────────
# NEVOUT_APP_URL=https://nevout-meds-liberia-pilot.vercel.app
# NEVOUT_ALERT_WEBHOOK_URL=<incoming webhook URL, if you want alerts pushed>
